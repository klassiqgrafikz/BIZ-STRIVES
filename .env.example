# BIZ-STRIVES — Vercel-unified env
# 1) Copy to .env.local for local dev
# 2) On Vercel: Storage → Create Postgres + KV + Blob + add these in Settings → Environment Variables
#    DATABASE_URL is auto-injected when you Create Postgres (choose Pooler / Pooled for serverless)
#    Add others manually: JWT_SECRET, RESEND_API_KEY, etc.

# ── Database (Vercel Postgres / Neon) ──
# Vercel auto-injects: DATABASE_URL (pooled) + POSTGRES_URL + DIRECT_URL (unpooled for migrations)
DATABASE_URL="postgresql://user:password@ep-xxx.pooler.neon.tech/bizstrives?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/bizstrives?sslmode=require"

# ── Auth ──
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="change-me-to-32-char-random-hex-32chars+"
JWT_EXPIRES_IN="7d"
REFRESH_SECRET="change-me-refresh-secret-32chars+"
NEXTAUTH_SECRET="change-me-nextauth-secret-32chars+"

# ── Email (Resend) ──
# https://resend.com/api-keys → re_xxx
RESEND_API_KEY="re_xxx"
RESEND_FROM="BIZ-STRIVES <noreply@yourdomain.com>"

# ── Cron protection ──
# Optional: set a secret, Vercel will send Authorization: Bearer $CRON_SECRET to /api/crons/*
CRON_SECRET="change-me-cron-secret"

# ── Redis (Upstash via Vercel Marketplace) — for BullMQ future ──
REDIS_URL="redis://default:password@xxx.upstash.io:6379"

# ── Storage (Vercel Blob) for invoice/statement PDFs ──
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# ── Optional ──
# NODE_ENV=production set by Vercel automatically
