# ═══════════════════════════════════════════════════════════════════
# BIZ-STRIVES — Complete ENV (Vercel + Supabase backend)
# ═══════════════════════════════════════════════════════════════════
# Setup: copy this file → .env.local  and fill values
# Vercel: Project → Settings → Environment Variables → add same keys
# Supabase: Project → Settings → Database + API keys
# Prisma uses DATABASE_URL (pooler, port 6543) + DIRECT_URL (direct, port 5432)
# ───────────────────────────────────────────────────────────────────

# ── 1. DATABASE (Supabase Postgres) — REQUIRED ─────────────────────
# Supabase → Project → Settings → Database → Connection string
#   - Use "Connection pooling" (port 6543, pgbouncer) for DATABASE_URL  ← for Vercel serverless
#   - Use "Direct connection" (port 5432) for DIRECT_URL               ← for migrations/seed
# Format: postgresql://postgres.[project-ref]:[password]@[pool-host]:6543/postgres?pgbouncer=true
# Example pooler host: aws-0-eu-central-1.pooler.supabase.com  (region varies)
# REQUIRED: yes | Get from: https://supabase.com → your project → Settings → Database
DATABASE_URL="postgresql://postgres.yztcqebmzvpsbxcrelmc:klassiqgrafikz2026@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres:klassiqgrafikz2026@db.yztcqebmzvpsbxcrelmc.supabase.co:5432/postgres"

# ── 2. SUPABASE API (for future Supabase Auth/Storage/Realtime) ───
# Supabase → Project → Settings → API → Project URL + anon/service_role keys
# REQUIRED: only if you plan to use Supabase JS client directly (optional for Prisma backend)
# Get from: https://supabase.com → Settings → API
SUPABASE_URL="https://yztcqebmzvpsbxcrelmc.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl6dGNxZWJtenZwc2J4Y3JlbG1jIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgyNTQ0ODYsImV4cCI6MjEwMzgzMDQ4Nn0.wBzST-JOBbpvSm54T9i9DXBlELlN7lhGkoU6_SGTxTk"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl6dGNxZWJtenZwc2J4Y3JlbG1jIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4ODI1NDQ4NiwiZXhwIjoyMTAzODMwNDg2fQ.96FMqKnH8PCAwhCI15ZFXwDz1nPRGzS904Vl67Rxdyo"
# For Next.js client (public): duplicate as NEXT_PUBLIC_*
NEXT_PUBLIC_SUPABASE_URL="https://yztcqebmzvpsbxcrelmc.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl6dGNxZWJtenZwc2J4Y3JlbG1jIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgyNTQ0ODYsImV4cCI6MjEwMzgzMDQ4Nn0.wBzST-JOBbpvSm54T9i9DXBlELlN7lhGkoU6_SGTxTk"

# ── 3. AUTH (JWT + NextAuth) — REQUIRED ────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED: yes | All three must be 32+ random chars, never commit real values
NEXTAUTH_URL="https://bizstrives.vercel.app"
# For production on Vercel: change to https://<project>.vercel.app  or https://yourdomain.com
NEXTAUTH_SECRET="00198525aa8bcfd0e02027bfc90f3267"
JWT_SECRET="9081063d035e174092b6799a42d8dfd8"
JWT_EXPIRES_IN="No expiry date"
REFRESH_SECRET="9bbefd9a15ac2658e8e7f4a418360fd3"
# Note: JWT_SECRET signs httpOnly cookie bizstrives_token (src/lib/auth/jwt.ts:1)

# ── 4. EMAIL (Resend + Gmail SMTP) ─────────────────────────────────────
# Get Resend API key from: https://resend.com → API Keys → Create → re_xxx
# Also verify domain in Resend → Domains → Add yourdomain.com
# RECOMMENDED: also set GMAIL SMTP for higher sending limits (100/day Resend limit avoided)
# Generate GMAIL_APP_PASSWORD: Google Account → Security → 2FA → App Passwords → "Mail"
# GMAIL_USER = your full Gmail address (e.g. business@yourdomain.com or yourname@gmail.com)
RESEND_API_KEY="re_xxx"
RESEND_FROM="BIZ-STRIVES <noreply@yourdomain.com>"

# Gmail SMTP (Nodemailer) — optional but recommended for bulk/Production
# Without these, email sending falls back to Resend (or stub in dev)
GMAIL_USER="your-gmail-address@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password-here"

# ── 5. CRON PROTECTION — OPTIONAL but recommended ──────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# If set, Vercel sends Authorization: Bearer $CRON_SECRET to /api/crons/month-end & /birthday
# Src: src/app/api/crons/month-end/route.ts:6
CRON_SECRET="change-me-cron-secret-16chars+"

# ── 6. REDIS (Upstash via Vercel Marketplace) — OPTIONAL/Future ───
# For BullMQ background jobs (Phase 19 automations) — Vercel Marketplace → Upstash Redis → Create → auto-injects
# Get from: Vercel Storage → Upstash → .env pull or https://console.upstash.com
# OPTIONAL: leave localhost for dev, mocked if unreachable
REDIS_URL="redis://default:password@xxx.upstash.io:6379"
# Upstash also provides: KV_URL, KV_REST_API_URL, etc. — not needed for Prisma backend

# ── 7. STORAGE (Vercel Blob OR Supabase Storage) — OPTIONAL ────────
# Option A: Vercel Blob (current) — Vercel Storage → Blob → Create → auto-injects
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"
# Option B: Supabase Storage (if you prefer Supabase) — Supabase → Storage → Create bucket → copy keys
# Supabase storage uses same SUPABASE_URL + SERVICE_ROLE; no extra token needed
# Choose one; invoice/statement PDFs fallback to mock if neither set

# ── 8. OPTIONAL / SYSTEM (auto-set by Vercel) ─────────────────────
# NODE_ENV=production  (auto)
# VERCEL_URL=xxx.vercel.app (auto)
