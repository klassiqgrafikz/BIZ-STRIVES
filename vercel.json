{
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/crons/month-end",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/crons/birthday",
      "schedule": "0 7 * * *"
    }
  ],
  "env": {
    "DATABASE_URL": "@database-url",
    "JWT_SECRET": "@jwt-secret"
  }
}
